@{
    ViewData["Title"] = "Sala 2";
}

<main class="sala">
    <section class="sala-contenido">
        <h1>@ViewBag.Sala.Nombre</h1>
        <p>@ViewBag.Sala.Narrativa</p>

        <section class="acertijo">
            <h2>Acertijo</h2>
            <p>@ViewBag.Sala.Acertijo</p>

            <div class="opciones">
                <a class="opcion" href="@Url.Action("Sala2", "Home", new { respuesta = "brujula" })">Una brújula</a>
                <a class="opcion" href="@Url.Action("Sala2", "Home", new { respuesta = "mapa" })">Un mapa</a>
                <a class="opcion" href="@Url.Action("Sala2", "Home", new { respuesta = "reloj" })">Un reloj</a>
                <a class="opcion" href="@Url.Action("Sala2", "Home", new { respuesta = "cofre" })">Un cofre</a>
            </div>
        </section>
    </section>
</main>