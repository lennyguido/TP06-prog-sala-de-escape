@{
     ViewData["Title"] = "Inicio";
}

<header class="hero">
   <section class="hero__content">
    <p class="hero__eyebrow">Sala de escape pirata</p>
    <h1>Bienvenido a la sala de escape</h1>
    <p>
        Una aventura entre mapas antiguos, cofres ocultos y pistas que solo la tripulación más astuta podrá resolver.
    </p>
    <a class="hero__button" href='@Url.Action("Identificarse", "Home")'>Comenzar la travesía</a>
    <a class="hero__button" href='@Url.Action("MisPartidas", "Home")'>Continuar partida</a>
    <img src="https://th.bing.com/th/id/OIP.M0JHLX_a1WHs95XV-8ge1gHaEK?w=309&h=180&c=7&r=0&o=7&pid=1.7&rm=3">
</section>
</header>

<main>
    <section id="reto" class="info-section">
        <article class="info-card">
            <h2>Objetivo</h2>
            <p>Encontrar el tesoro antes de que el capitán cierre el barco y desaparezca en el mar.</p>
        </article>

        <article class="info-card">
            <h2>Temática</h2>
            <p>Islas perdidas, brújulas, barcos y pistas escondidas en cada rincón de la cubierta.</p>
        </article>

        <article class="info-card">
            <h2>Preparación</h2>
            <ul>
                <li>Observa cada detalle.</li>
                <li>Trabaja en equipo.</li>
                <li>Resuelve el misterio.</li>
            </ul>
        </article>
    </section>
</main>